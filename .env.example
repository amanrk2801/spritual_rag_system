GEMINI_API_KEY=your-gemini-api-key
ADMIN_API_KEY=generate-a-long-random-string
# PUBLIC_API_KEY=
ENVIRONMENT=dev
LOG_LEVEL=INFO
LOG_JSON=false

# Models
GENERATION_MODEL=gemini-3.8-flash
REWRITE_MODEL=gemini-3.5-flash-lite
OCR_MODEL=gemini-3.8-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
GENERATION_THINKING_LEVEL=low

# Vector store: leave QDRANT_URL empty for embedded mode (dev); set for production
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
COLLECTION_NAME=scriptures

# Ingestion
OCR_MODE=auto
OCR_CONCURRENCY=8
CHUNK_SIZE_CHARS=1100
CHUNK_OVERLAP_CHARS=220

# Retrieval
TOP_K=6
PREFETCH_K=40
RATE_LIMIT_PER_MINUTE=30
